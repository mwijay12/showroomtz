rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // VOLTASHOWROOM FIRESTORE SECURITY RULES
    // Clean rules — robust public catalog reads and inquiry creation
    // ============================================================

    // PUBLIC VEHICLE CATALOG — Anyone can browse
    match /cars/{carId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // SHOWROOM BRANCHES & DEALERS — Anyone can view
    match /showrooms/{showroomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dealers/{dealerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // REVIEWS — Public reads, logged-in users create
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // SETTINGS (Branding, Theme, Stats) — Public reads
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PUBLIC MEDIA & ASSETS — Public reads
    match /media/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // BUYER INQUIRIES & DEPOSIT VOUCHERS — Anyone can create & read
    match /inquiries/{inquiryId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // CONTACT MESSAGES — Anyone can send
    match /messages/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // BOOKINGS & INQUIRY SESSION PROTOCOLS — Anyone can create/read
    match /bookings/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // FINANCIAL DATA — Authenticated users only
    match /sales_transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }

    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    match /payments/{id} {
      allow read, write: if request.auth != null;
    }

    // USER PROFILES — Authenticated users or user document read
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // NOTIFICATIONS
    match /notifications/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // GLOBAL FALLBACK — Anyone can read public collections, write if auth
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

